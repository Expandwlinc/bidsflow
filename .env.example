# Base de datos
DATABASE_URL="postgresql://user:password@localhost:5432/bidsflow?schema=public"

# NextAuth — genera un secreto con: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Anthropic — requerido para el análisis con IA del pliego de cargos
ANTHROPIC_API_KEY=""

# Scraper / cron — token bearer para proteger POST /api/cron/scrape
CRON_SECRET=""

# Fuente OCDS de PanamaCompraenCifras — verificar dominio de producción antes de depender de él
OCDS_BASE_URL="https://ocdsv2dev.panamacompraencifras.gob.pa"

# Conector experimental del portal en vivo — deshabilitado por defecto
PORTAL_LIVE_SCRAPER_ENABLED="false"

# Almacenamiento de documentos: "local" (por defecto, disco local — no
# persiste en Vercel) o "vercel-blob" (requiere conectar Blob storage al
# proyecto en Vercel, que inyecta BLOB_READ_WRITE_TOKEN automáticamente)
STORAGE_DRIVER="local"

# Datos del primer usuario admin (usado por prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme123"
SEED_ADMIN_NAME="Admin"
